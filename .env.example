# ===== 数据仓库（GitHub / Gitee 等支持 git+token 的托管）=====
# 托管主机：github.com（默认）或 gitee.com
#GIT_HOST=gitee.com
# 访问数据仓库的 token
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
NEXUS_DATA_OWNER=andaoai
NEXUS_DATA_REPO=nexus-data
NEXUS_DATA_BRANCH=main
# 本地 bare 仓库缓存根目录（默认 <运行目录>/data，即 ./data/nexus-data.git）
#CACHE_DIR=

# ===== HTTP 服务 =====
ADDR=:8080

# ===== EasyTier 内嵌组网（可选，全部配置才启用）=====
#EASYTIER_NETWORK_NAME=nexus-crm
#EASYTIER_NETWORK_SECRET=your-secret
#EASYTIER_IPV4=10.144.144.1/24
#EASYTIER_PEERS=tcp://public.easytier.cn:11010

# ===== Claude API（v0.4.0 Agent 预留）=====
#CLAUDE_API_KEY=sk-ant-xxxx
